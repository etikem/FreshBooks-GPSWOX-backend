# ─── Server ─────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma-separated list of frontend origins permitted to call /admin.
# Must include the URL the Next.js dashboard is served from.
# Use "*" only in dev to allow any origin.
CORS_ORIGINS=http://localhost:3000

# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql://freshbooks:freshbooks@localhost:5432/freshbooks

# ─── FreshBooks ─────────────────────────────────────────────
# Personal access token from FreshBooks → Developer settings.
FRESHBOOKS_API_TOKEN=replace_me
FRESHBOOKS_ACCOUNT_ID=replace_me
FRESHBOOKS_BUSINESS_ID=replace_me
FRESHBOOKS_API_BASE=https://api.freshbooks.com
# Shared secret used to verify webhook HMAC signatures.
FRESHBOOKS_WEBHOOK_SECRET=replace_me

# ─── GPSWOX ─────────────────────────────────────────────────
# Base URL of the GPSWOX install (e.g. https://track.example.com).
GPSWOX_API_BASE=https://your-gpswox-host.example.com
GPSWOX_API_KEY=$2y$10$g7ellOILZB6rPTGpceQKLeDPZN1tQJ5IdZ39unztW6ykv
# Endpoint paths are configurable so we don't hard-code GPSWOX URLs.
GPSWOX_ENDPOINT_UPDATE_USER=/api/users/{userId}
GPSWOX_ENDPOINT_ENABLE_DEVICES=/api/users/{userId}/devices/enable
GPSWOX_ENDPOINT_DISABLE_DEVICES=/api/users/{userId}/devices/disable
GPSWOX_HTTP_TIMEOUT_MS=15000

# ─── Admin auth ─────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string
ADMIN_EMAIL=dmeo@storeshine.net
# bcrypt hash of the admin password. Generate with:
#   node -e "console.log(require('bcryptjs').hashSync('yourpass', 12))"
ADMIN_PASSWORD_HASH=replace_with_bcrypt_hash

# ─── Retry worker ───────────────────────────────────────────
RETRY_POLL_INTERVAL_MS=10000
RETRY_MAX_ATTEMPTS=8
