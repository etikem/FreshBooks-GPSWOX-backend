# ─── Server ─────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma-separated list of frontend origins permitted to call /admin.
# Must include the URL the Next.js dashboard is served from.
# Use "*" only in dev to allow any origin.
CORS_ORIGINS=http://localhost:3000

# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql://freshbooks:freshbooks@localhost:5432/freshbooks

# ─── FreshBooks ─────────────────────────────────────────────
# OAuth client credentials — from FreshBooks → Developer settings → "Apps".
FRESHBOOKS_CLIENT_ID=replace_me
FRESHBOOKS_CLIENT_SECRET=replace_me
# Initial access + refresh token issued during OAuth authorization. After
# the first successful refresh the values in the `oauth_tokens` Postgres
# table are authoritative — these env values are only used as a one-time
# bootstrap when the row is missing. Do NOT update them after deploy; let
# the rotation pipeline handle it.
FRESHBOOKS_API_TOKEN=replace_me
FRESHBOOKS_API_REFRESH_TOKEN=replace_me
FRESHBOOKS_ACCOUNT_ID=replace_me
FRESHBOOKS_BUSINESS_ID=replace_me
FRESHBOOKS_API_BASE=https://api.freshbooks.com
FRESHBOOKS_OAUTH_TOKEN_URL=https://api.freshbooks.com/auth/oauth/token
# The verifier returned by FreshBooks when you registered the webhook
# callback. FreshBooks sends this value back as `verified=...` in every
# webhook body — we compare against it in constant time. (HMAC headers
# are also accepted as a fallback.)
#
# Two accepted shapes:
#   1. Plain string — one verifier shared across every registered event.
#        FRESHBOOKS_WEBHOOK_SECRET=replace_me
#   2. JSON object — different verifier per event type (FreshBooks issues
#      a separate one for each callback). Keys are lowercased event names.
#        FRESHBOOKS_WEBHOOK_SECRET={"invoice.create":"...","client.create":"...","payment.create":"..."}
FRESHBOOKS_WEBHOOK_SECRET=replace_me

# ─── FreshBooks rate limiting / pagination ──────────────────
# Max outbound FreshBooks requests started per second. The HTTP client
# spaces requests by 1000/rps ms so a bulk sweep stays under FreshBooks'
# server limit and never trips 429. Lower if you still see rate limiting.
FRESHBOOKS_RATE_LIMIT_RPS=5
# Retries for 429 / 5xx / network failures. Backoff honours Retry-After
# when present, otherwise exponential backoff with jitter.
FRESHBOOKS_MAX_RETRIES=5
# Page size for paginated list endpoints (clients, invoices). 100 = max.
FRESHBOOKS_PAGE_SIZE=100
# Reconciliation bulk invoice fetch only pulls invoices created within this
# many days (device qty comes from each client's latest invoice, and active
# clients bill monthly). Set 0 to fetch ALL invoices regardless of age.
FRESHBOOKS_INVOICE_LOOKBACK_DAYS=180

# ─── Reconciliation sweep (ABC Track ↔ FreshBooks) ──────────
# Invoice line-item name that carries the per-device billing quantity.
RECONCILE_DEVICE_LINE_NAME=GPS Monthly Fee
# How many ABC Track rows to classify in parallel. With the bulk-prefetch
# design this only bounds ABC Track form-detail lookups (not FreshBooks).
RECONCILE_CONCURRENCY=5

# ─── Admin auth ─────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
ADMIN_USERNAME=administrator
# bcrypt hash of the admin password. Generate with:
#   node -e "console.log(require('bcryptjs').hashSync('yourpass', 12))"
ADMIN_PASSWORD_HASH=replace_with_bcrypt_hash

# Per-IP rate limit on POST /admin/login (failed attempts also count).
LOGIN_RATE_LIMIT_PER_MIN=10

# ─── Retry worker ───────────────────────────────────────────
RETRY_POLL_INTERVAL_MS=10000
RETRY_MAX_ATTEMPTS=8

# ─── Boot / Cron sweeps ─────────────────────────────────────
# Reprocess WebhookEvent rows that were never marked processed (e.g. the
# previous run died mid-flight). Off in test environments.
CATCHUP_SWEEP_ON_BOOT=true
# How often the worker re-evaluates ACTIVE clients whose accessExpiresAt
# is in the past. Default: 1h. Lower in tests, raise in massive deployments.
CRON_SWEEP_INTERVAL_MS=3600000
