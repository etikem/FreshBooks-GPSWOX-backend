generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
//  Tenant (single-tenant for now, but the model leaves room
//  for multi-tenant later — every Client/Event references one)
// ─────────────────────────────────────────────────────────────
model Tenant {
  id              String   @id @default(cuid())
  name            String
  freshbooksAccountId String
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  clients         Client[]
  webhookEvents   WebhookEvent[]
  syncRuns        SyncRun[]

  @@map("tenants")
}

// ─────────────────────────────────────────────────────────────
//  Client — links a FreshBooks customer to an ABC Track user
// ─────────────────────────────────────────────────────────────
enum ClientStatus {
  ACTIVE                    // ABC Track access enabled
  BLOCKED                   // ABC Track access disabled (outstanding balance > 0)
  CANCELLED                 // contract ended
  UNKNOWN                   // never synced yet
  NO_MATCHING_GPSWOX_USER   // FreshBooks client exists but no ABC Track user shares the email (enum value retained for migration compatibility)
}

model Client {
  id                  String   @id @default(cuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id])

  email               String
  name                String?
  // Detailed profile pulled from FreshBooks /users/clients/<id> on the
  // client.create webhook. All optional — clients in the wild often have
  // sparse FreshBooks profiles.
  firstName           String?
  lastName            String?
  organization        String?
  businessPhone       String?
  mobilePhone         String?
  homePhone           String?
  addressStreet       String?
  addressStreet2      String?
  addressCity         String?
  addressProvince     String?
  addressCountry      String?
  addressCode         String?
  currencyCode        String?
  language            String?
  vatName             String?
  vatNumber           String?
  notes               String?
  freshbooksClientId  String
  gpswoxUserId        String?

  contractStartDate   DateTime
  contractEndDate     DateTime
  // Latest date the client has paid through, derived from invoices.
  paidThroughDate     DateTime?
  // Latest date ABC Track is set to expire (mirror of what we pushed to ABC Track).
  accessExpiresAt     DateTime?

  status              ClientStatus @default(UNKNOWN)
  // Last computed outstanding balance, stored as numeric for safety.
  lastOutstanding     Decimal?     @db.Decimal(14, 2)
  lastSyncedAt        DateTime?

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  invoices            InvoiceCache[]
  paymentLogs         PaymentLog[]
  actionLogs          ActionLog[]
  retryJobs           RetryJob[]
  syncRuns            SyncRun[]

  @@unique([tenantId, freshbooksClientId])
  @@index([email])
  @@index([status])
  @@map("clients")
}

// ─────────────────────────────────────────────────────────────
//  Webhook event — raw + idempotency
// ─────────────────────────────────────────────────────────────
model WebhookEvent {
  id          String   @id @default(cuid())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])

  // External event id from FreshBooks (used for idempotency).
  // We dedupe on (source, eventId).
  source      String   // "freshbooks"
  eventId     String
  eventType   String   // e.g. "payment.create"
  rawPayload  Json
  signature   String?  // HMAC header captured for forensics

  receivedAt  DateTime @default(now())
  processedAt DateTime?
  processed   Boolean  @default(false)
  failed      Boolean  @default(false)
  failureReason String?

  // Cross-link to the SyncRun that processed this event.
  syncRunId   String?
  syncRun     SyncRun? @relation(fields: [syncRunId], references: [id])

  @@unique([source, eventId])
  @@index([processed, receivedAt])
  @@map("webhook_events")
}

// ─────────────────────────────────────────────────────────────
//  Invoice cache — snapshot of the latest pull from FreshBooks
//  (truth always lives in FreshBooks; this is for the UI only)
// ─────────────────────────────────────────────────────────────
model InvoiceCache {
  id                   String   @id @default(cuid())
  clientId             String
  client               Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  freshbooksInvoiceId  String
  invoiceNumber        String?
  amount               Decimal  @db.Decimal(14, 2)
  paid                 Decimal  @db.Decimal(14, 2)
  balance              Decimal  @db.Decimal(14, 2)
  currency             String
  status               String   // raw FreshBooks status
  issuedDate           DateTime?
  dueDate              DateTime?

  // Soft-delete fields. When FreshBooks no longer returns an invoice we
  // previously cached (deleted/voided), we flip active=false rather than
  // dropping the row, so the operator can still see the historical record.
  // The decision pipeline never reads from the cache (truth lives in
  // FreshBooks), so this is purely a UI/audit affordance.
  active               Boolean  @default(true)
  voidedAt             DateTime?

  fetchedAt            DateTime @default(now())

  @@unique([clientId, freshbooksInvoiceId])
  @@index([clientId, dueDate])
  @@index([clientId, active])
  @@map("invoice_cache")
}

// ─────────────────────────────────────────────────────────────
//  PaymentLog — every payment event we observed
// ─────────────────────────────────────────────────────────────
model PaymentLog {
  id                   String   @id @default(cuid())
  clientId             String
  client               Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  freshbooksPaymentId  String?
  invoiceId            String?
  amount               Decimal  @db.Decimal(14, 2)
  currency             String
  paidAt               DateTime?
  source               String   // "webhook" | "manual" | "sync"
  rawPayload           Json?

  createdAt            DateTime @default(now())

  @@index([clientId, paidAt])
  @@map("payment_logs")
}

// ─────────────────────────────────────────────────────────────
//  ActionLog — every decision/action we took (audit trail)
// ─────────────────────────────────────────────────────────────
enum ActionKind {
  DECISION_BLOCK
  DECISION_RESTORE
  GPSWOX_ENABLE
  GPSWOX_DISABLE
  GPSWOX_UPDATE_EXPIRATION
  GPSWOX_MATCHED
  ERROR
  MANUAL_SYNC
}

model ActionLog {
  id          String     @id @default(cuid())
  clientId    String?
  client      Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)

  kind        ActionKind
  message     String
  details     Json?
  // Hash of (clientId + kind + canonical-details) used for idempotency
  // when retrying the same outbound ABC Track call.
  idempotencyKey String?

  createdAt   DateTime   @default(now())

  @@unique([idempotencyKey])
  @@index([clientId, createdAt])
  @@index([kind, createdAt])
  @@map("action_logs")
}

// ─────────────────────────────────────────────────────────────
//  RetryJob — failed outbound calls, retried with backoff
// ─────────────────────────────────────────────────────────────
enum RetryStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED      // exhausted attempts
  CANCELLED   // operator cancelled
}

model RetryJob {
  id            String      @id @default(cuid())
  clientId      String
  client        Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Operation to retry. The handler dispatches on this.
  operation     String      // e.g. "gpswox.enable", "gpswox.disable", "gpswox.updateExpiration"
  payload       Json
  // Stable idempotency key so the eventual call is safe even if we
  // fired a stale duplicate from another path.
  idempotencyKey String

  status        RetryStatus @default(PENDING)
  attempts      Int         @default(0)
  maxAttempts   Int         @default(8)
  nextAttemptAt DateTime    @default(now())
  lastError     String?

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  succeededAt   DateTime?

  @@index([status, nextAttemptAt])
  @@index([clientId, status])
  @@map("retry_jobs")
}

// ─────────────────────────────────────────────────────────────
//  SyncRun — one end-to-end evaluation for a client
// ─────────────────────────────────────────────────────────────
enum SyncTrigger {
  WEBHOOK
  MANUAL
  CRON
  RETRY
}

enum SyncOutcome {
  RESTORED
  BLOCKED
  NO_CHANGE
  ERROR
}

// ─────────────────────────────────────────────────────────────
//  OauthToken — durable storage for rotating OAuth credentials.
//  Single row per `provider`. Updated on every refresh.
//  Read+written by every node in a multi-node deployment, so
//  refreshes are coordinated via a Postgres advisory lock keyed
//  on the same `provider` string. See utils/pg-lock.ts.
// ─────────────────────────────────────────────────────────────
model OauthToken {
  provider     String    @id                                      // "freshbooks"
  accessToken  String    @map("access_token")
  refreshToken String    @map("refresh_token")
  // Wall-clock expiry computed from the `expires_in` we got back.
  // Used for proactive refresh; nullable because not every flow
  // returns it (and we still rely on 401 as the source of truth).
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(3)
  // Bumped on every successful refresh. Used by the advisory-lock
  // pattern to detect "another node already refreshed while we
  // were waiting for the lock".
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("oauth_tokens")
}

model SyncRun {
  id              String      @id @default(cuid())
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id])
  clientId        String?
  client          Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)

  trigger         SyncTrigger
  outcome         SyncOutcome?
  outstanding     Decimal?    @db.Decimal(14, 2)
  paidThroughDate DateTime?
  notes           String?

  startedAt       DateTime    @default(now())
  finishedAt      DateTime?

  events          WebhookEvent[]

  @@index([clientId, startedAt])
  @@index([outcome, startedAt])
  @@map("sync_runs")
}
