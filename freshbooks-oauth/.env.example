# FreshBooks OAuth credentials — get these from
# https://my.freshbooks.com/#/developer
FRESHBOOKS_CLIENT_ID=your-client-id-here
FRESHBOOKS_CLIENT_SECRET=your-client-secret-here

# Initial access + refresh token issued during the OAuth authorization flow.
# After the first refresh, the values in token-store.json are authoritative —
# these env values are only used as a bootstrap when token-store.json is empty.
FRESHBOOKS_API_TOKEN=your-initial-access-token-here
FRESHBOOKS_API_REFRESH_TOKEN=your-initial-refresh-token-here

# Optional: where to persist rotated tokens. Default: ./token-store.json
# In production, point this to a path outside the repo (e.g. /var/lib/app/tokens.json)
# or replace the file driver with a database/secret-store driver.
TOKEN_STORE_PATH=./token-store.json

# Server port
PORT=3000
